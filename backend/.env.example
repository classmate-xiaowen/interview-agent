# 对话 / Guardrail 大模型（DeepSeek，兼容 OpenAI 协议）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=          # 填入你的 DeepSeek API Key

# 向量 Embedding（DeepSeek 不提供 embedding；此处接阿里云百炼，兼容 OpenAI 协议）
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=        # 填入阿里云百炼（DashScope）API Key
EMBED_MODEL=qwen3.7-text-embedding

CHAT_MODEL=deepseek-flash
GUARDRAIL_MODEL=deepseek-flash
CHROMA_DIR=./chroma_data
DB_PATH=sqlite+aiosqlite:///./speak_agent.db
MAX_QUESTIONS=5
