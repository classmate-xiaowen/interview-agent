# ===== 对话 / Guardrail 大模型：阿里云百炼（OpenAI 兼容模式） =====
# 百炼控制台获取 API-Key：https://bailian.console.aliyun.com/  → 右上角「API-KEY」
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=YOUR_BAILIAN_API_KEY          # TODO: 替换为你的百炼 API-Key（DASHSCOPE_API_KEY）
CHAT_MODEL=qwen-plus                       # 对话/点评模型；可选 qwen-max / qwen-turbo / qwen-long 等
GUARDRAIL_MODEL=qwen-plus                  # 护栏（轻量判定）模型
LLM_PROVIDER=bailian                       # bailian / deepseek，决定思考链参数是否下发

# ===== 向量 Embedding =====
# 百炼亦提供 text-embedding-v3，可改用百炼能力：
#   EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBED_API_KEY=<同上百炼 API-Key>
#   EMBED_MODEL=text-embedding-v3
# 默认走 OpenAI：
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=YOUR_OPENAI_API_KEY
EMBED_MODEL=text-embedding-3-small

# ===== 其它 =====
CHROMA_DIR=./chroma_data
DB_PATH=sqlite+aiosqlite:///./speak_agent.db
MAX_QUESTIONS=12
LLM_MAX_TOKENS=8192
LLM_DISABLE_THINKING=True
