# 对话 / Guardrail 大模型（DeepSeek，兼容 OpenAI 协议）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=          # 填入你的 DeepSeek API Key

# 向量 Embedding（DeepSeek 不提供 embedding，默认走 OpenAI；可换成任意兼容服务）
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=        # 填入 Embedding 服务的 API Key（如 OpenAI）
EMBED_MODEL=text-embedding-3-small

CHAT_MODEL=v4flash
GUARDRAIL_MODEL=v4flash
CHROMA_DIR=./chroma_data
DB_PATH=sqlite+aiosqlite:///./speak_agent.db
MAX_QUESTIONS=5
